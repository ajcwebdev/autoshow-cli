{
  "name": "autoshow-bun-cli",
  "version": "0.1.0",
  "type": "module",
  "author": "Anthony Campolo",
  "license": "MIT",
  "scripts": {
    "repo": "bun src/tools/repomix.ts",
    "audit:ocr-tokens": "bun scripts/audit-ocr-token-shapes.ts",
    "toolchain:produce-unsigned": "bun src/tools/macos-toolchain-producer.ts produce",
    "toolchain:verify-unsigned": "bun src/tools/macos-toolchain-producer.ts verify",
    "toolchain:verify-source-fallback": "bun src/tools/macos-toolchain-producer.ts verify-source-fallback",
    "check": "bun src/tools/unique-source-name-check.ts && bunx tsc --noEmit",
    "t": "bun test/test-runner.ts",
    "autoshow": "bun src/cli/create-cli.ts",
    "as": "bun autoshow",
    "setup": "bun autoshow setup"
  },
  "dependencies": {
    "@valibot/to-json-schema": "1.6.0",
    "tiktoken": "1.0.22",
    "valibot": "1.3.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.12",
    "repomix": "1.13.1",
    "typescript": "6.0.2"
  }
}
