{
  "name": "autoshow-bun-cli",
  "version": "0.1.0",
  "type": "module",
  "author": "Anthony Campolo",
  "license": "MIT",
  "scripts": {
    "repo": "bun src/tools/repo-snapshot.ts",
    "audit:ocr-tokens": "bun src/tools/audit-ocr-token-shapes.ts",
    "analyze:complexity": "bun src/tools/analyze-typescript-complexity.ts --scope src --scope test",
    "check": "bun src/tools/unique-source-name-check.ts && bunx tsc --noEmit",
    "t": "bun test/test-runner.ts",
    "autoshow": "bun src/cli/create-cli.ts",
    "as": "bun autoshow",
    "setup": "bun autoshow setup"
  },
  "dependencies": {
    "@valibot/to-json-schema": "1.7.1",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "6.0.3"
  }
}
