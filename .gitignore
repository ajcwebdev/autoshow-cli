# input/ ships a small set of example fixtures and nothing else; everything else under it is
# personal media. Git will not re-include a file whose parent directory is excluded, so the
# chain below excludes each level with `/*` and negates the next directory down before that
# directory's own contents are excluded. There is no brace expansion in .gitignore, so every
# subdirectory is named on its own line.
#
# This whole block must stay at the bottom of the file, below the global binary globs above:
# last matching pattern wins, so `**/*.mp3`, `**/*.png`, and `**/*.jpeg` would otherwise
# re-ignore the audio and image fixtures the file-level negations allow. A new global glob
# appended after this block would silently drop fixtures;
# `test/test-cases/validation/fixtures/shipped-fixture-contracts.test.ts` fails when that happens.
input/*
!input/examples/
input/examples/*
!input/examples/audio/
!input/examples/batch/
!input/examples/comic/
!input/examples/document/
!input/examples/lyrics/
!input/examples/tts/
input/examples/audio/*
input/examples/batch/*
input/examples/comic/*
input/examples/document/*
input/examples/lyrics/*
input/examples/tts/*

# input/examples/video/ is deliberately absent above: the only 2-video.mp4 references in the
# repo are to the hosted https://ajc.pics/autoshow/examples/2-video.mp4 copy, not a local file.
#
# The shipped fixtures, named one per line. Personal media sits in these same directories
# (5-audio.mp3, anthony-voice-8-seconds.mp3, unreferenced tts drafts) and
# stays ignored by omission, so this list is an allowlist and must not become a glob.
!input/examples/audio/0-audio-short.mp3
!input/examples/audio/1-audio.mp3
!input/examples/audio/anthony-voice.mp3
!input/examples/batch/2-direct-urls.md
!input/examples/batch/2-urls.md
!input/examples/batch/example-rss-feeds.md
!input/examples/comic/01-registry-check.md
!input/examples/comic/README.md
!input/examples/document/1-document.jpg
!input/examples/document/1-document.pdf
!input/examples/document/1-document.png
!input/examples/document/1-docx.docx
!input/examples/document/1-epub.epub
!input/examples/document/1-odt.odt
!input/examples/document/1-pptx.pptx
!input/examples/document/1-xlsx.xlsx
!input/examples/document/3-document.pdf
!input/examples/document/4-document.pdf
!input/examples/document/30-document.pdf
!input/examples/document/protected.pdf
!input/examples/lyrics/01-cover.jpeg
!input/examples/lyrics/01-example-song.mp3
!input/examples/lyrics/01-example-song.txt
!input/examples/tts/0-tts-short.txt
!input/examples/tts/1-tts.md
!input/examples/tts/tts-dialogue.txt
